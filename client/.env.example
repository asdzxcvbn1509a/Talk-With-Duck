# คัดลอกเป็น client/.env · ตอน deploy บน Vercel ให้ตั้งค่าเหล่านี้ใน Project Settings → Environment Variables

# OAuth Client ID ของปุ่ม "Sign in with Google" (ค่าเดียวกับ GOOGLE_CLIENT_ID ใน server/.env ไม่ใช่ความลับ)
# ตอน dev เว้นว่างได้ถ้าใช้แค่ปุ่มบัญชีทดสอบ · วิธีสร้างอยู่ใน docs/deploy.md ข้อ 2
VITE_GOOGLE_CLIENT_ID=

# ตอน dev ไม่ต้องตั้งสองค่านี้ (Vite proxy ส่ง /api และ /socket.io ไปที่ localhost:4000 ให้เอง)
# VITE_API_URL: ปล่อยว่างทั้งตอน dev และบน Vercel = เรียก /api ผ่าน rewrite ใน vercel.json (cookie เป็น same-origin)
# ตั้งเฉพาะเมื่อโฮสต์หน้าเว็บที่ไม่มี rewrite (ไม่แนะนำ: cookie ข้ามโดเมน) ค่าต้องลงท้ายด้วย /api
VITE_API_URL=
# Socket.IO ต่อตรงไปที่ Render (Vercel rewrite ไม่รองรับ WebSocket) · ตอน dev หน้าเว็บไม่อ่านค่านี้
# ตั้งบน Vercel เป็น URL ของ service บน Render (อยู่ด้านบนของหน้า service) เช่น https://talk-with-duck-api.onrender.com
VITE_SOCKET_URL=

# ลิงก์ภายนอก (ไม่บังคับ): ไม่ตั้ง = ปุ่มและข้อความที่ชวนไปลิงก์นั้นจะไม่แสดง
# แบบประเมินความพึงพอใจ (Google Forms ตัวชี้วัดข้อ 4.6 ข้อ 5) แสดงในหน้า "ฉัน" และการ์ดกิจกรรมวันที่ 18 ธ.ค. 2026
VITE_SURVEY_URL=
# ช่องทางติดต่อทีมผู้ดูแล เช่น https://www.facebook.com/<เพจ> หรือ mailto:<อีเมลทีม>
# แสดงในหน้า "ฉัน" หน้าเข้าสู่ระบบ (มีปัญหาในการเข้าสู่ระบบ) และหน้า error
VITE_CONTACT_URL=

# โดเมนของเว็บ เช่น https://talk-with-duck.vercel.app ใช้ทำรูปตัวอย่างตอนแชร์ลิงก์ใน LINE/Facebook (og:image)
# บน Vercel ไม่ต้องตั้ง (Vercel ส่งโดเมน production ให้ตอน build เอง) ตั้งเฉพาะเมื่อ build ที่อื่น
VITE_SITE_URL=
