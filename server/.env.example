# คัดลอกไฟล์นี้เป็น server/.env แล้วแก้ค่าให้ตรงกับเครื่องของตัวเอง (ห้าม commit ไฟล์ .env)

NODE_ENV=development
PORT=4000
# หน้าเว็บที่อนุญาต (คั่นด้วย , ได้หลายโดเมน)
CLIENT_ORIGIN=http://localhost:5173
# จำนวน proxy หน้า server: dev = 0, Render = 3, Vercel rewrite + Render = 4 (ตรวจได้ที่ /api/health?ip)
TRUST_PROXY=0

# ---------- ฐานข้อมูล ----------
# dev: PostgreSQL ในเครื่อง (ใส่รหัสผ่านของ user postgres ที่ตั้งตอนติดตั้ง)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/talkwithduck
# ฐานข้อมูลสำหรับเทสต์อัตโนมัติ (ข้อมูลจะถูกล้างทุกครั้งที่รันเทสต์)
# ไม่บังคับ: ถ้าไม่ตั้ง จะใช้ DATABASE_URL แต่ต่อท้ายชื่อฐานด้วย _test ให้เอง
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/talkwithduck_test
DATABASE_POOL_MAX=5
# prod (Supabase): ตั้งเป็น true
DATABASE_SSL=false

# ---------- ระบบยืนยันตัวตน ----------
# สุ่มใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# โดเมนอีเมลที่เข้าสู่ระบบได้ คั่นด้วย , · * = บัญชี Google ใดก็ได้ (ใส่ mail.kmutt.ac.th ถ้าจะให้เฉพาะนักศึกษา)
ALLOWED_EMAIL_DOMAINS=*

# ---------- เข้าสู่ระบบด้วย Google (วิธีสร้าง Client ID อยู่ใน docs/deploy.md ข้อ 2) ----------
# ค่าเดียวกับ VITE_GOOGLE_CLIENT_ID ใน client/.env (ไม่ใช่ความลับ) · ตอน dev เว้นว่างได้ถ้าใช้แค่บัญชีทดสอบ
GOOGLE_CLIENT_ID=
# ปุ่มบัญชีทดสอบในหน้าเข้าสู่ระบบ (บัญชีจาก seed) ใช้ได้เฉพาะ NODE_ENV=development
# ห้ามตั้งบนเว็บจริง: server จะไม่ยอมเริ่มทำงานถ้า NODE_ENV=production
DEV_LOGIN=true

# ---------- คาราโอเกะ (ไม่บังคับ: ถ้าไม่มี key จะใช้การวางลิงก์ YouTube แทนการค้นหา) ----------
YOUTUBE_API_KEY=

# ---------- WebRTC TURN (ไม่บังคับตอน dev แต่ควรมีตอนใช้งานจริง) ----------
# ได้จาก Metered แผนฟรี ขั้นตอนอยู่ใน docs/deploy.md ข้อ 6 · ตอน dev เว้นว่างได้ (ใช้แค่ STUN)
# TURN_URLS ใส่หลาย URL คั่นด้วย , เช่น turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

GROUP_ROOM_MAX=10
